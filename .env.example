# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT="3000"

# JWT Secret for authentication tokens
JWT_SECRET="foodbasket_super_secret_jwt_key_2026"

# Razorpay Test Credentials (Optional - built-in test mode works seamlessly out of the box)
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="sampleSecretKey456"

# Database connection (Built-in persistent JSON/In-memory store is enabled by default with seed data; configurable for MongoDB URI)
MONGODB_URI="mongodb://localhost:27017/foodbasket"

